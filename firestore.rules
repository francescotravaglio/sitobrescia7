rules_version = '2';

// REGOLE FIRESTORE — AGESCI Brescia 7
//
// ⚠️ Per attivarle: Firebase Console → Firestore Database → Regole → incolla → Pubblica
//    https://console.firebase.google.com/project/agescibrescia7-508b0/firestore/rules
//
// isAdmin(): utente Firebase Auth con email @agescibrescia7.com verificata
// (capi/admin). Il controllo email_verified impedisce che un account creato
// via self-signup (se mai riabilitato per errore) ottenga privilegi admin
// solo indovinando/scegliendo un indirizzo @agescibrescia7.com: senza aver
// dimostrato di possedere davvero quella casella (cliccando il link di
// verifica), l'account resta un utente qualunque agli occhi delle regole.
// I soci usano email {codice}@soci.agescibrescia7.com e non sono admin:
// quel dominio non termina con "@agescibrescia7.com" quindi resta escluso.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.matches('.*@agescibrescia7[.]com$');
    }

    // ── Contenuti pubblici: lettura libera, scrittura solo admin ──
    match /annunci/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /eventi/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /informazioni/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Pre-iscrizioni: il pubblico può solo CREARE (con validazione) ──
    match /pre_iscrizioni/{doc} {
      allow create: if
        request.resource.data.genitore_nome is string    && request.resource.data.genitore_nome.size() > 0    && request.resource.data.genitore_nome.size() < 100 &&
        request.resource.data.genitore_cognome is string && request.resource.data.genitore_cognome.size() < 100 &&
        request.resource.data.bambino_nome is string     && request.resource.data.bambino_nome.size() < 100 &&
        request.resource.data.email is string            && request.resource.data.email.size() < 200 && request.resource.data.email.matches('.*@.*') &&
        request.resource.data.letta == false;
      allow read, update, delete: if isAdmin();
    }

    // ── Iscrizioni complete: il modulo in documenti.html genera solo il PDF in locale,
    //    non scrive più su Firestore. Collection mantenuta solo per lo storico esistente.
    match /iscrizioni/{doc} {
      allow read, write: if isAdmin();
    }

    // ── Testimonianze: lettura pubblica, invio pubblico con validazione ──
    match /testimonianze/{doc} {
      allow read: if true;
      allow create: if
        request.resource.data.nome is string  && request.resource.data.nome.size() > 0  && request.resource.data.nome.size() < 50 &&
        request.resource.data.testo is string && request.resource.data.testo.size() > 0 && request.resource.data.testo.size() < 400 &&
        request.resource.data.approvata == false;
      allow update, delete: if isAdmin();
    }

    // ── Libro dei Totem: lettura pubblica solo delle voci approvate (quelle in
    //    attesa di moderazione sono leggibili solo dagli admin), invio pubblico
    //    con validazione. Il client pubblico deve interrogare con
    //    where('approvato','==',true): senza quel filtro nella query, Firestore
    //    nega l'intera lettura ai non-admin (non filtra silenziosamente) perché
    //    non può garantire che ogni documento restituito rispetti la regola ──
    match /totem/{doc} {
      allow read: if resource.data.approvato == true || isAdmin();
      allow create: if
        request.resource.data.nome is string  && request.resource.data.nome.size() > 0  && request.resource.data.nome.size() < 50 &&
        request.resource.data.totem is string && request.resource.data.totem.size() > 0 && request.resource.data.totem.size() < 60 &&
        request.resource.data.anno is string  && request.resource.data.anno.size() > 0  && request.resource.data.anno.size() < 10 &&
        request.resource.data.approvato == false;
      allow update, delete: if isAdmin();
    }

    // soci_attivazione e soci_auth: collection morte, nessuna pagina del sito le usa più
    // da quando l'Area Soci è stata rimossa. Niente più regole dedicate: restano quindi
    // negate dal catch-all qui sotto, come "tutto il resto". I documenti residui (PIN e
    // password legacy in chiaro) vanno esportati per lo storico ed eliminati direttamente
    // da Firebase Console, che bypassa queste regole.

    // ── Tutto il resto: negato ──
    match /{document=**} { allow read, write: if false; }
  }
}
